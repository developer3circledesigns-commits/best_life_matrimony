# =============================================
#  BestLife Matrimony - React SPA (Hostinger Shared Hosting)
#  Apache 2.4 - public_html/.htaccess
# =============================================

# --- 1. Security: hide .htaccess, prevent directory listing ---
<Files ".htaccess">
  Require all denied
</Files>
Options -Indexes
ServerSignature Off

# --- 2. HTTPS redirect (uncomment after SSL is active on Hostinger) ---
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>

# --- 3. SPA fallback - all non-file routes to index.html (React Router) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If requested resource is a real file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise forward to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# --- 4. Custom 404 fallback (Hostinger serves 404.html then index.html) ---
ErrorDocument 404 /index.html

# --- 5. Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# --- 6. Caching (long cache for hashed assets, short for html) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Hashed assets (Vite adds hash) can be immutable
  <FilesMatch "\.(js|css|woff2|woff|png|jpg|jpeg|webp|gif|mp4|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- 7. MIME types (Hostinger sometimes misses these) ---
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>
