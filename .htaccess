# BestLife Matrimony â€” PHP routing (clean URLs)
# Allows /about â†’ about.php, /matches â†’ matches.php, etc.
# Preserves direct .php access and asset files.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If request is for existing file/directory, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Clean URLs without extension -> .php
  RewriteRule ^about/?$ about.php [L]
  RewriteRule ^matches/?$ matches.php [L]
  RewriteRule ^advertise/?$ advertise.php [L]
  RewriteRule ^contact/?$ contact.php [L]
  RewriteRule ^register/?$ register.php [L]
  RewriteRule ^404/?$ 404.php [L]

  # Fallback for unknown routes -> 404.php (not React SPA)
  # Uncomment to enable SPA-like fallback:
  # RewriteCond %{REQUEST_URI} !\.php$  [NC]
  # RewriteCond %{REQUEST_URI} !\.html$ [NC]
  # RewriteRule ^ 404.php [L]
</IfModule>

# DirectoryIndex prefers PHP
DirectoryIndex index.php index.html

# Security
<Files ".htaccess">
  Require all denied
</Files>
Options -Indexes
ServerSignature Off

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|gif|mp4|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Handle PHP extension fallback for Apache without MultiViews
ErrorDocument 404 /404.php
